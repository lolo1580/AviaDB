# Copiez ce fichier en `.env` puis adaptez les valeurs.
# Docker Compose le lit automatiquement.

# Mot de passe d'accès à l'application (http://<hote>/).
# ⚠️ CHANGEZ-LE. S'il est laissé vide, la protection est désactivée
#    et n'importe qui sur le réseau peut tout consulter et modifier.
ADMIN_PASSWORD=change-me

# Base de données PostgreSQL (service « db » du compose).
DATABASE_URL=postgresql+psycopg://aviadb:change-me@localhost:5434/aviadb

# Identifiant du compte administrateur créé au premier démarrage.
# ADMIN_USERNAME=admin

# Mot de passe du conteneur PostgreSQL (service « db »).
# POSTGRES_PASSWORD=change-me

# Clé de signature des jetons de session (optionnel).
# Si vide, elle est dérivée d'ADMIN_PASSWORD (changer le mot de passe invalide
# les sessions en cours).
# SECRET_KEY=

# Durée de validité d'une session admin, en secondes (défaut : 12 h).
# ADMIN_TOKEN_TTL=43200

# Derrière un proxy TLS en amont : passez à true (cookie Secure).
# ADMIN_COOKIE_SECURE=false

# Fournisseur de taux de change (BCE via frankfurter.dev par défaut).
# RATES_API_URL=https://api.frankfurter.dev/v1

# --- Images publiées (GHCR) ----------------------------------------------
# Utilisées par docker-compose.registry.yml (images construites par la CI).
REGISTRY=ghcr.io/lolo1580
AVIADB_TAG=latest

# --- Médias ---------------------------------------------------------------
# UPLOAD_DIR=./uploads
# IMAGE_MAX_DIMENSION=1600
# IMAGE_WEBP_QUALITY=85
# IMAGE_THUMB_QUALITY=80
# MAX_UPLOAD_BYTES=15728640
# Distance de Hamming tolérée entre empreintes perceptuelles (0 à 64).
# PHOTO_DUPLICATE_DISTANCE=5
# MEDIA_CLEANUP_INTERVAL=86400
# MEDIA_CLEANUP_MIN_AGE=3600

# --- Sauvegardes planifiées ----------------------------------------------
# BACKUP_DIR=/app/backups
# BACKUP_KEEP=7
# BACKUP_INTERVAL=86400

# --- Journal d'activité ---------------------------------------------------
# ACTIVITY_KEEP=5000

# --- Sécurité / API publique ---------------------------------------------
# ADMIN_MAX_FAILURES=10
# PUBLIC_RATE_LIMIT=60
# PUBLIC_RATE_WINDOW=60
